# --- LLM backend ------------------------------------------------------------
# Default backend: claude | openai | gemini | mistral | ollama
# Override per session:  npm run chat -- client@x.com --provider=openai
# List them all:         npm run chat -- --list-providers
#
# Only the transport changes. The memory store, retrieval and the per-client
# boundary are identical on every backend. What each one gives up is documented
# in README.md -> "Backends".
AGENT_PROVIDER=claude

# --- Claude API (reference backend) -----------------------------------------
# Either export ANTHROPIC_API_KEY, or run `ant auth login` and leave this unset
# (the SDK picks up the stored profile automatically).
ANTHROPIC_API_KEY=

# Model + reasoning depth. Effort is the cost/quality lever for chat traffic:
# high is the API default; medium and low are usually indistinguishable on
# routine conversational turns and cost meaningfully less. Measure before
# lowering a default. Claude-only: no other backend here exposes an equivalent.
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=high

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional: point at an OpenAI-compatible gateway (Azure, proxy, LiteLLM).
OPENAI_BASE_URL=

# --- Google Gemini ----------------------------------------------------------
# Note: Gemini has no system role inside a conversation, so retrieved memories
# travel in the client's own turn behind delimiters. Weaker than a real system
# channel — see README.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- Mistral ----------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# --- Ollama (local models, no key, no cost) ---------------------------------
# Nothing leaves the machine, which can matter given what the memory store
# holds. Tool-calling quality varies sharply by model — verify yours actually
# calls remember_client_fact before trusting it with real conversations.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- PostgreSQL -------------------------------------------------------------
DATABASE_URL=
# Set to "require" for managed Postgres (Neon, Supabase, RDS).
PGSSLMODE=

# --- Embeddings (optional) --------------------------------------------------
# Anthropic does not serve an embeddings endpoint, so vectors come from a
# separate provider. Leave VOYAGE_API_KEY empty to run without embeddings:
# retrieval then falls back to Postgres full-text search, which works but
# matches on wording rather than meaning.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
# Must match the vector(N) column width in db/migrations/001_init.sql.
EMBEDDING_DIM=1024

# --- Retrieval tuning -------------------------------------------------------
# Text-search dictionary. "simple" does no stemming, so it behaves the same in
# any language; switch to english/french if your clients are monolingual.
# NOTE: this must match the dictionary hardcoded in the memories.content_tsv
# generated column (db/migrations/001_init.sql). A generated column cannot read
# a setting at runtime, so changing this means editing both places -- otherwise
# queries stop matching the index.
FTS_CONFIG=simple
RECALL_LIMIT=8
HISTORY_TURNS=12
